{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|str_replace",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/davis/Gemini NotebookLM/scripts/check-diagnostics.sh'",
            "statusMessage": "Verificando erros após escrita..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_ID=codex bash '/home/davis/Gemini NotebookLM/auto-commit.sh'",
            "statusMessage": "Commitando alterações da sessão..."
          }
        ]
      }
    ]
  }
}
