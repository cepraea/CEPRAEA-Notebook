{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/davis/Gemini NotebookLM/scripts/check-diagnostics.sh'",
            "statusMessage": "Verificando erros..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_ID=claude-code bash '/home/davis/Gemini NotebookLM/auto-commit.sh'",
            "statusMessage": "Commitando alterações da sessão..."
          }
        ]
      }
    ]
  }
}
